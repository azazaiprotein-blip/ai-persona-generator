# Folium environment configuration
# Copy this file to `.env.local` and fill in your values.

# Optional. When set, personas are generated with Claude for maximum quality.
# Without it, Folium falls back to its built-in local generator and still
# works fully offline.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Override the Claude model used for generation.
# Defaults to claude-opus-4-8.
# ANTHROPIC_MODEL=claude-opus-4-8
